#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$current_script_path")")

# shellcheck source=../lib/utils.bash
source "${plugin_dir}/lib/utils.bash"

# Every published version of the Warp Agent CLI, newest first.
#
# The list is read from Warp's own version manifest
# (https://releases.warp.dev/channel_versions.json), so it tracks what
# Warp has actually published rather than what a tag list claims.
#
# Pass channel names to narrow it down, e.g. `bin/list-all stable`.
list_all_versions "$@"
