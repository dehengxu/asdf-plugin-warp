#!/usr/bin/env bash

set -euo pipefail

# Relative paths (to ASDF_INSTALL_PATH) of the directories that hold the
# executables asdf should create shims for.
#
# asdf's plugin contract wants paths *relative* to the install directory --
# "bin" means "${ASDF_INSTALL_PATH}/bin". An absolute path here would point
# at the wrong place and asdf would create no shim at all.
echo "bin"
